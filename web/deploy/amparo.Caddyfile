# ─────────────────────────────────────────────────────────────────────────────
# amparo.ellmstack.dev — Amparo web surface (contract: docs/web-surface.md §6)
#
# Caddy v2 site config. Import from the main Caddyfile with:
#
#     import /etc/caddy/amparo.Caddyfile
#
# Architecture:
#   browser → Caddy :443 (automatic TLS via Let's Encrypt, once the operator
#     creates the grey-cloud A record) → reverse_proxy 127.0.0.1:47910
#     (amparo-web.service, sandboxed, non-root)
#
# Auth: the app itself requires a bearer token (AMPARO_WEB_TOKEN) on every
# /api/* route and SSE stream; the static shell is public but holds no data.
# ─────────────────────────────────────────────────────────────────────────────

amparo.ellmstack.dev {
	encode zstd gzip

	# ── Update-notification surface ────────────────────────────────────────
	# Static files generated by deploy.sh into /srv/amparo/site. Handled
	# before the reverse_proxy so the app never sees these paths, and
	# served from this origin so the operator UI can compare
	# /version.json same-origin (no CORS needed).
	handle /version.json {
		root * /srv/amparo/site
		file_server
		header Cache-Control "no-cache"
	}
	handle /changelog {
		root * /srv/amparo/site
		rewrite * /changelog.html
		file_server
		header Cache-Control "no-cache"
	}
	handle /feed.xml {
		root * /srv/amparo/site
		file_server
		header Cache-Control "no-cache"
	}

	# ── Gate surface ──────────────────────────────────────────────────────────
	# /approvals is the shipped `--approval-endpoint` seam. Loopback callers
	# (the spawned web gate) are exempt; every non-loopback request is
	# refused by the app unless it carries the approval-scoped bearer
	# (AMPARO_APPROVAL_TOKEN, R3) — the app fails closed when that token is
	# unset. Proxied (not 403'd) so remote fan-out gates and receivers can
	# publish and poll through the same guarded seam.
	handle /approvals* {
		reverse_proxy 127.0.0.1:47910
	}

	# ── App (SPA + JSON API + SSE) ────────────────────────────────────────────
	# flush_interval -1 so the task event stream (text/event-stream) arrives
	# live instead of buffered.
	handle {
		reverse_proxy 127.0.0.1:47910 {
			flush_interval -1
		}
	}

	# Site-level (matcher-less) header block: applies to ALL paths (a `header /`
	# directive only matches the literal root). Mirrors the console/guardrail
	# block; CSP tightened for this app: no external fonts, no inline scripts.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cache-Control "no-cache"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
	}
}
